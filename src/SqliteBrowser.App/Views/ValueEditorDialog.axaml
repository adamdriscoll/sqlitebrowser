<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqliteBrowser.App.Views.ValueEditorDialog"
        Width="760" Height="600"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Title="Value Editor">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,220,*" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="SQLite storage class:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="StorageClassSelector"
                Grid.Column="1"
                AutomationProperties.AutomationId="ValueEditorDialog.StorageClass"
                SelectionChanged="OnStorageClassChanged" />
      <TextBlock x:Name="ReadOnlyText" Grid.Column="2" Text="Read-only inspection"
                 HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" IsVisible="False" />
    </Grid>

    <StackPanel x:Name="JsonTools" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Format JSON" Click="OnFormatJsonClick" AutomationProperties.AutomationId="ValueEditorDialog.FormatJsonButton" />
      <Button Content="Minify JSON" Click="OnMinifyJsonClick" AutomationProperties.AutomationId="ValueEditorDialog.MinifyJsonButton" />
      <Button Content="Validate JSON" Click="OnValidateJsonClick" AutomationProperties.AutomationId="ValueEditorDialog.ValidateJsonButton" />
    </StackPanel>

    <Grid Grid.Row="2">
      <TextBlock x:Name="NullEditor" Text="This value is SQL NULL." FontSize="18"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
      <TextBox x:Name="TextEditor"
               AutomationProperties.AutomationId="ValueEditorDialog.TextEditor"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" />
      <Grid x:Name="BlobEditor" ColumnDefinitions="3*,2*" IsVisible="False">
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="ImportBlobButton" Content="Import..." Click="OnImportBlobClick"
                    AutomationProperties.AutomationId="ValueEditorDialog.ImportBlobButton" />
            <Button Content="Export..." Click="OnExportBlobClick" AutomationProperties.AutomationId="ValueEditorDialog.ExportBlobButton" />
          </StackPanel>
          <TextBox x:Name="HexEditor"
                   AutomationProperties.AutomationId="ValueEditorDialog.HexEditor"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                   TextChanged="OnHexTextChanged"
                   VerticalContentAlignment="Top" />
        </DockPanel>
        <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseLowColor}" Padding="8">
          <Grid>
            <TextBlock x:Name="ImagePlaceholder" Text="No supported image preview"
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="ImagePreview" Stretch="Uniform" IsVisible="False" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick"
              AutomationProperties.AutomationId="ValueEditorDialog.CancelButton" />
      <Button x:Name="SaveButton" Content="Apply" Click="OnSaveClick" IsDefault="True"
              AutomationProperties.AutomationId="ValueEditorDialog.ApplyButton" />
    </StackPanel>
  </Grid>
</Window>
